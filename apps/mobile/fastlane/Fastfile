fastlane_version "2.225.0"

default_platform :ios

platform :ios do

  # Helper: returns API key hash if env vars are set
  def api_key_if_available
    if ENV["APP_STORE_CONNECT_API_KEY_ID"]
      params = {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        in_house: false,
      }
      if ENV["APP_STORE_CONNECT_API_KEY_PATH"]
        params[:key_filepath] = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
      else
        params[:key_content] = ENV["APP_STORE_CONNECT_API_KEY"]
      end
      app_store_connect_api_key(params)
    else
      nil
    end
  end

  desc "Build iOS app for simulator"
  lane :build_simulator do
    sh("cd .. && flutter build ios --simulator --no-codesign")
  end

  desc "Build iOS app for TestFlight using Match"
  lane :build_testflight do
    api_key = api_key_if_available

    # Fetch certificates and provisioning profiles from git repo
    match(
      type: "appstore",
      app_identifier: "com.trackeo.client.app",
      readonly: is_ci,
      api_key: api_key,
    )

    # Build Flutter for iOS release (no codesign — Xcode handles it via Match)
    sh("cd .. && flutter build ios --release --no-codesign")

    # Build the IPA with Match provisioning
    build_app(
      scheme: "Runner",
      workspace: File.expand_path("../ios/Runner.xcworkspace", __dir__),
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.expand_path("../build/ios/ipa", __dir__),
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.trackeo.client.app" => "match AppStore com.trackeo.client.app"
        }
      }
    )
  end

  desc "Upload to TestFlight"
  lane :upload_testflight do
    api_key = api_key_if_available

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.trackeo.client.app",
      skip_waiting_for_build_processing: true,
      notify_external_testers: false,
    )
  end

  desc "Build and upload to TestFlight"
  lane :release do
    build_testflight
    upload_testflight
  end

  desc "Sync Match certificates (read-only)"
  lane :sync_certs do
    api_key = api_key_if_available

    match(
      type: "appstore",
      app_identifier: "com.trackeo.client.app",
      readonly: true,
      api_key: api_key,
    )
  end

  desc "Create provisioning profile for new app"
  lane :create_profile do
    api_key = api_key_if_available

    match(
      type: "appstore",
      app_identifier: "com.trackeo.client.app",
      readonly: false,
      api_key: api_key,
    )
  end
end

platform :android do
  desc "Build Android APK"
  lane :build_apk do
    sh("cd .. && flutter build apk --release")
  end

  desc "Upload to Google Play (Internal)"
  lane :upload_play_store do
    supply(
      track: "internal",
      apk: "../build/app/outputs/flutter-apk/app-release.apk"
    )
  end
end
