---
import Layout from '../../layouts/Layout.astro';
import AccountEmailShell from '../../components/AccountEmailShell.astro';
---

<Layout title="Nouveau mot de passe | iooeh" robots="noindex, nofollow">
  <div data-endpoint="https://api.iooeh.com/auth/reset-password">
    <AccountEmailShell eyebrow="Sécurité du compte" title="Choisissez un nouveau mot de passe." copy="Utilisez au moins 8 caractères et une combinaison que vous n’utilisez pas ailleurs.">
      <form class="account-form" data-reset-form>
        <div class="account-field"><label for="password">Nouveau mot de passe</label><input id="password" name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required /></div>
        <div class="account-field"><label for="confirmation">Confirmez le mot de passe</label><input id="confirmation" name="confirmation" type="password" minlength="8" maxlength="128" autocomplete="new-password" required /></div>
        <p class="account-error" data-error hidden></p>
        <button class="account-action" type="submit">Enregistrer le mot de passe</button>
      </form>
      <a class="account-action" href="https://app.iooeh.com" data-login hidden>Se connecter</a>
    </AccountEmailShell>
  </div>
</Layout>

<script>
  const root = document.querySelector('[data-endpoint]');
  if (root instanceof HTMLElement) {
    const form = root.querySelector('[data-reset-form]');
    const error = root.querySelector('[data-error]');
    const title = root.querySelector('[data-account-title]');
    const copy = root.querySelector('[data-account-copy]');
    const icon = root.querySelector('[data-account-icon]');
    const login = root.querySelector('[data-login]');
    const token = new URLSearchParams(location.hash.slice(1)).get('token');
    history.replaceState(null, '', location.pathname);
    const fail = (message: string) => { if (error) { error.textContent = message; error.removeAttribute('hidden'); } };
    if (!token) { form?.setAttribute('hidden',''); icon?.classList.add('is-error'); if(title) title.textContent='Lien invalide ou expiré.'; if(copy) copy.textContent='Demandez un nouveau lien depuis l’écran de connexion.'; }
    form?.addEventListener('submit', async (event) => {
      event.preventDefault(); if (!token || !(form instanceof HTMLFormElement)) return;
      const data = new FormData(form); const password=String(data.get('password') ?? ''); const confirmation=String(data.get('confirmation') ?? '');
      if (password.length < 8) return fail('Le mot de passe doit contenir au moins 8 caractères.');
      if (password !== confirmation) return fail('Les mots de passe ne correspondent pas.');
      const button=form.querySelector('button'); if(button instanceof HTMLButtonElement) button.disabled=true;
      try { const response=await fetch(root.dataset.endpoint!,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token,password})}); if(!response.ok) throw new Error(); form.hidden=true; icon?.classList.add('is-success'); if(title) title.textContent='Mot de passe modifié.'; if(copy) copy.textContent='Votre nouveau mot de passe est actif.'; if(login instanceof HTMLAnchorElement) login.hidden=false; }
      catch { fail('Ce lien est invalide ou a expiré.'); if(button instanceof HTMLButtonElement) button.disabled=false; }
    });
  }
</script>
