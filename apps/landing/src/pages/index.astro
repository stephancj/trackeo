---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Trackeo — Suivi GPS en temps réel">

<!-- ═══════════════════════════════════════════════════════
     NAVBAR
═══════════════════════════════════════════════════════ -->
<header class="nav-header">
  <nav class="nav-inner">
    <!-- Logo -->
    <a href="/" class="nav-logo">
      <div class="logo-mark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="2.5" fill="#030508"/>
          <path d="M12 3C7.03 3 3 7.03 3 12s4.03 9 9 9 9-4.03 9-9-4.03-9-9-9zm0 14.5A5.5 5.5 0 1 1 12 6.5a5.5 5.5 0 0 1 0 11z" fill="#030508"/>
          <path d="M12 1v3M12 20v3M1 12h3M20 12h3" stroke="#030508" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="logo-text">TRACKEO</span>
    </a>

    <!-- Links -->
    <div class="nav-links">
      <a href="#features" class="nav-link">Fonctionnalités</a>
      <a href="#how" class="nav-link">Comment ça marche</a>
      <a href="#pricing" class="nav-link">Tarifs</a>
    </div>

    <!-- CTA -->
    <div class="nav-right">
      <span class="nav-status">
        <span class="status-dot"><span class="ping-anim"></span><span></span></span>
        <span class="mono" style="font-size:11px;color:var(--green);">LIVE</span>
      </span>
      <a href="https://trackeo.zenkai.mg" class="nav-cta">Accéder →</a>
    </div>
  </nav>
</header>


<!-- ═══════════════════════════════════════════════════════
     HERO
═══════════════════════════════════════════════════════ -->
<section class="hero-section">

  <!-- Background grid -->
  <div class="hero-bg grid-bg"></div>

  <!-- Radar glow orbs -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>

  <!-- Radar sweep circle (decorative, behind content) -->
  <div class="radar-container">
    <div class="radar-circle radar-c1"></div>
    <div class="radar-circle radar-c2"></div>
    <div class="radar-circle radar-c3"></div>
    <div class="radar-sweep"></div>
    <!-- Blips -->
    <div class="radar-blip" style="top:30%;left:58%;"></div>
    <div class="radar-blip" style="top:62%;left:38%;animation-delay:0.8s;"></div>
    <div class="radar-blip" style="top:45%;left:65%;animation-delay:1.6s;"></div>
  </div>

  <div class="hero-container">
    <div class="hero-layout">

      <!-- LEFT: Text -->
      <div class="hero-left">

        <!-- Signal badge -->
        <div class="signal-badge">
          <span class="status-dot inline"><span class="ping-anim"></span><span></span></span>
          <span class="mono" style="font-size:11px;letter-spacing:0.08em;color:var(--green);">SIGNAL ACQUIS — TRACKING EN COURS</span>
        </div>

        <!-- Headline -->
        <h1 class="hero-headline">
          <span class="hl-outline">Vos</span>
          <span class="hl-solid">véhicules</span>
          <span class="hl-green">toujours</span>
          <span class="hl-solid">en vue.</span>
        </h1>

        <p class="hero-sub">
          Tracking GPS temps réel pour votre flotte à Madagascar.
          Alertes WhatsApp instantanées, geofencing, rapports complets.
          <strong>Opérationnel en 5 minutes.</strong>
        </p>

        <!-- CTAs -->
        <div class="hero-ctas">
          <a href="https://trackeo.zenkai.mg" class="cta-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/></svg>
            Essayer gratuitement
          </a>
          <a href="#features" class="cta-ghost">
            Voir les fonctionnalités
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </a>
        </div>

        <!-- Metrics strip -->
        <div class="hero-metrics">
          <div class="metric">
            <span class="metric-val mono">10s</span>
            <span class="metric-lbl">Fréquence GPS</span>
          </div>
          <div class="metric-sep"></div>
          <div class="metric">
            <span class="metric-val mono">99.9%</span>
            <span class="metric-lbl">Uptime</span>
          </div>
          <div class="metric-sep"></div>
          <div class="metric">
            <span class="metric-val mono">900+</span>
            <span class="metric-lbl">Protocoles GPS</span>
          </div>
        </div>
      </div>

      <!-- RIGHT: Dashboard mockup -->
      <div class="hero-right">

        <!-- Floating stat cards -->
        <div class="stat-float stat-f1 float-anim">
          <span class="mono" style="font-size:22px;font-weight:700;color:white;line-height:1;">10s</span>
          <span style="font-size:10px;color:var(--text-muted);margin-top:2px;">GPS refresh</span>
        </div>
        <div class="stat-float stat-f2 float-anim" style="animation-delay:1s;">
          <div style="display:flex;align-items:center;gap:6px;">
            <span style="font-size:16px;">🇲🇬</span>
            <div>
              <div style="font-size:12px;font-weight:700;color:white;">Madagascar</div>
              <div style="font-size:10px;color:var(--text-muted);">Solution locale</div>
            </div>
          </div>
        </div>

        <!-- Main dashboard card -->
        <div class="dash-card scanlines">

          <!-- Window chrome -->
          <div class="dash-chrome">
            <div class="chrome-dots">
              <span style="background:#FF5F57;"></span>
              <span style="background:#FFBD2E;"></span>
              <span style="background:#28CA42;"></span>
            </div>
            <span class="mono" style="font-size:10px;color:#2A3D35;">trackeo.zenkai.mg — flotte</span>
            <div class="chrome-live">
              <span class="status-dot inline sm"><span class="ping-anim"></span><span></span></span>
              <span class="mono" style="font-size:10px;font-weight:700;color:var(--green);">LIVE</span>
            </div>
          </div>

          <!-- Map area -->
          <div class="dash-map-area">
            <svg class="map-svg" viewBox="0 0 540 260" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
              <!-- Background tiles subtle -->
              <rect width="540" height="260" fill="#070D14"/>

              <!-- Grid lines (map tiles) -->
              <g stroke="rgba(61,255,154,0.05)" stroke-width="1" fill="none">
                <line x1="0" y1="65" x2="540" y2="65"/>
                <line x1="0" y1="130" x2="540" y2="130"/>
                <line x1="0" y1="195" x2="540" y2="195"/>
                <line x1="90" y1="0" x2="90" y2="260"/>
                <line x1="180" y1="0" x2="180" y2="260"/>
                <line x1="315" y1="0" x2="315" y2="260"/>
                <line x1="430" y1="0" x2="430" y2="260"/>
              </g>

              <!-- Road network -->
              <g stroke="rgba(61,255,154,0.1)" stroke-width="1.5" fill="none">
                <line x1="0" y1="130" x2="540" y2="130"/>
                <line x1="180" y1="0" x2="180" y2="260"/>
                <path d="M 90 195 Q 135 195 180 130 Q 225 65 315 65"/>
              </g>
              <g stroke="rgba(61,255,154,0.2)" stroke-width="2" fill="none">
                <line x1="0" y1="130" x2="540" y2="130"/>
                <line x1="180" y1="0" x2="180" y2="260"/>
              </g>

              <!-- GPS route (ghost) -->
              <path d="M 60 205 L 180 205 L 180 130 L 315 130 L 315 65 L 430 65"
                fill="none" stroke="var(--green)" stroke-width="1.5"
                stroke-dasharray="5 4" stroke-linecap="round" opacity="0.15"/>

              <!-- GPS route (animated) -->
              <path class="route-animated"
                d="M 60 205 L 180 205 L 180 130 L 315 130 L 315 65 L 430 65"
                fill="none" stroke="var(--green)" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round"
                stroke-dasharray="600" stroke-dashoffset="600"/>

              <!-- Geofence zone -->
              <circle cx="430" cy="65" r="34" fill="rgba(77,158,255,0.06)" stroke="#4D9EFF" stroke-width="1.5" stroke-dasharray="4 3" opacity="0.8"/>
              <text x="430" y="30" text-anchor="middle" fill="#4D9EFF" font-size="8" font-family="JetBrains Mono,monospace" opacity="0.8">Zone Bureau</text>

              <!-- Origin point -->
              <circle cx="60" cy="205" r="4" fill="var(--green)" opacity="0.4"/>
              <circle cx="60" cy="205" r="2" fill="var(--green)"/>

              <!-- Vehicle 1 — active, in geofence -->
              <circle cx="430" cy="65" r="18" fill="rgba(61,255,154,0.08)" class="vring-anim"/>
              <circle cx="430" cy="65" r="11" fill="rgba(61,255,154,0.9)"/>
              <text x="430" y="69" text-anchor="middle" fill="#030508" font-size="10">🚗</text>

              <!-- Vehicle 2 — idle -->
              <circle cx="180" cy="130" r="14" fill="rgba(77,158,255,0.1)" class="vring-anim2"/>
              <circle cx="180" cy="130" r="9" fill="#4D9EFF" opacity="0.9"/>
              <text x="180" y="134" text-anchor="middle" fill="white" font-size="8">🚙</text>

              <!-- Vehicle 3 — offline -->
              <circle cx="315" cy="205" r="7" fill="rgba(74,98,88,0.4)"/>
              <text x="315" y="209" text-anchor="middle" fill="rgba(74,98,88,0.8)" font-size="8">🚐</text>

              <!-- Coordinate labels -->
              <text x="8" y="12" fill="rgba(61,255,154,0.2)" font-size="7" font-family="JetBrains Mono,monospace">-18.91°S</text>
              <text x="480" y="12" fill="rgba(61,255,154,0.2)" font-size="7" font-family="JetBrains Mono,monospace">47.53°E</text>
            </svg>

            <!-- Telemetry overlay -->
            <div class="telem-card" style="top:10px;right:10px;">
              <div class="telem-header">
                <span class="status-dot inline sm"><span class="ping-anim"></span><span></span></span>
                <span style="font-size:12px;font-weight:600;color:white;">Camion-01</span>
              </div>
              <div class="telem-data">
                <div class="telem-row"><span>Vitesse</span><span class="mono" style="color:var(--green);">72 km/h</span></div>
                <div class="telem-row"><span>Batterie</span><span class="mono" style="color:var(--amber);">84%</span></div>
                <div class="telem-row"><span>Signal</span><span class="mono" style="color:var(--green);">GSM 4G</span></div>
              </div>
              <div style="font-size:9px;color:var(--text-muted);margin-top:6px;font-family:'JetBrains Mono',monospace;">📍 Analakely, Tana</div>
            </div>

            <!-- Alert overlay -->
            <div class="alert-card" style="bottom:10px;left:10px;">
              <div class="alert-icon">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#4D9EFF" stroke-width="2.5"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <div style="font-size:11px;font-weight:600;color:white;">Entrée zone détectée</div>
                <div style="font-size:9px;color:var(--text-muted);font-family:'JetBrains Mono',monospace;">Camion-01 · Zone Bureau · il y a 12s</div>
              </div>
            </div>
          </div>

          <!-- Vehicle strip -->
          <div class="vehicle-strip">
            <div class="vstrip-item">
              <span class="vstatus active"></span>
              <div>
                <div style="font-size:11px;font-weight:600;color:white;">Camion-01</div>
                <div class="mono" style="font-size:9px;color:var(--text-muted);">72 km/h · 🔋 84%</div>
              </div>
            </div>
            <div class="vstrip-sep"></div>
            <div class="vstrip-item">
              <span class="vstatus idle"></span>
              <div>
                <div style="font-size:11px;font-weight:600;color:white;">Voiture-02</div>
                <div class="mono" style="font-size:9px;color:var(--text-muted);">En attente · 🔋 61%</div>
              </div>
            </div>
            <div class="vstrip-sep"></div>
            <div class="vstrip-item">
              <span class="vstatus offline"></span>
              <div>
                <div style="font-size:11px;font-weight:600;color:var(--text-muted);">Bus-03</div>
                <div class="mono" style="font-size:9px;color:var(--text-dim);">Hors ligne · 🔋 22%</div>
              </div>
            </div>
          </div>

        </div><!-- /dash-card -->
      </div><!-- /hero-right -->

    </div><!-- /hero-layout -->
  </div><!-- /hero-container -->

  <!-- Scroll cue -->
  <div class="scroll-cue">
    <div class="scroll-line"></div>
    <span class="mono" style="font-size:9px;color:var(--text-muted);letter-spacing:0.15em;">DÉFILER</span>
  </div>

</section>


<!-- ═══════════════════════════════════════════════════════
     TICKER
═══════════════════════════════════════════════════════ -->
<div class="ticker-bar">
  <div class="ticker-label mono">FLUX GPS</div>
  <div class="ticker-track">
    <div class="ticker-inner">
      <span class="titem"><span class="tdot green"></span><span class="mono">–18.9151°S, 47.5316°E</span>&nbsp;· Camion-01 · Analakely, Tana · <span style="color:var(--green);">72 km/h</span></span>
      <span class="titem"><span class="tdot blue"></span>Entrée zone &ldquo;Bureau Central&rdquo; · il y a 2 min</span>
      <span class="titem"><span class="tdot amber"></span><span class="mono">ALERTE</span>&nbsp;· Vitesse excessive · 94 km/h · Camion-03</span>
      <span class="titem"><span class="tdot red"></span><span class="mono">ALERTE</span>&nbsp;· Batterie faible 18% · Moto-04</span>
      <span class="titem"><span class="tdot green"></span>Voiture-02 · En ligne · Ankadifotsy · <span style="color:var(--green);">stationnaire</span></span>
      <span class="titem"><span class="tdot green"></span>Flotte du jour · <span class="mono">1 234 km</span> parcourus · 3 véhicules actifs</span>
      <span class="titem"><span class="tdot blue"></span>Bus-03 · Arrêt détecté · Ambohimanarina · <span class="mono">08:42</span></span>
      <!-- Duplicate for seamless loop -->
      <span class="titem"><span class="tdot green"></span><span class="mono">–18.9151°S, 47.5316°E</span>&nbsp;· Camion-01 · Analakely, Tana · <span style="color:var(--green);">72 km/h</span></span>
      <span class="titem"><span class="tdot blue"></span>Entrée zone &ldquo;Bureau Central&rdquo; · il y a 2 min</span>
      <span class="titem"><span class="tdot amber"></span><span class="mono">ALERTE</span>&nbsp;· Vitesse excessive · 94 km/h · Camion-03</span>
      <span class="titem"><span class="tdot red"></span><span class="mono">ALERTE</span>&nbsp;· Batterie faible 18% · Moto-04</span>
      <span class="titem"><span class="tdot green"></span>Voiture-02 · En ligne · Ankadifotsy · <span style="color:var(--green);">stationnaire</span></span>
      <span class="titem"><span class="tdot green"></span>Flotte du jour · <span class="mono">1 234 km</span> parcourus · 3 véhicules actifs</span>
      <span class="titem"><span class="tdot blue"></span>Bus-03 · Arrêt détecté · Ambohimanarina · <span class="mono">08:42</span></span>
    </div>
  </div>
</div>


<!-- ═══════════════════════════════════════════════════════
     FEATURES
═══════════════════════════════════════════════════════ -->
<section id="features" class="section-pad" style="background:var(--bg);">
  <div class="container">

    <div class="section-header">
      <span class="tag-chip">FONCTIONNALITÉS</span>
      <h2 class="section-title">Tout pour piloter<br/>votre flotte.</h2>
      <p class="section-sub">Un outil complet, taillé pour les réalités malgaches.</p>
    </div>

    <div class="bento-grid">

      <!-- Card 1: Large — Real-time tracking -->
      <div class="bcard bcard-lg">
        <div class="bcard-top">
          <div class="feat-icon green-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <span class="live-badge">EN DIRECT</span>
        </div>
        <h3 class="feat-title">Suivi en temps réel</h3>
        <p class="feat-desc">Position de tous vos véhicules sur carte, mise à jour toutes les 10 secondes. Vitesse, batterie, statut en un coup d'œil.</p>
        <div class="feat-viz">
          <svg width="100%" height="80" viewBox="0 0 380 80" xmlns="http://www.w3.org/2000/svg">
            <g stroke="rgba(61,255,154,0.07)" stroke-width="1" fill="none">
              <line x1="0" y1="28" x2="380" y2="28"/>
              <line x1="0" y1="56" x2="380" y2="56"/>
              <line x1="72" y1="0" x2="72" y2="80"/>
              <line x1="175" y1="0" x2="175" y2="80"/>
              <line x1="290" y1="0" x2="290" y2="80"/>
            </g>
            <path class="bento-route" d="M 20 64 L 72 64 L 72 28 L 175 28 L 175 14 L 290 14"
              fill="none" stroke="var(--green)" stroke-width="2.5" stroke-linecap="round"
              stroke-dasharray="500" stroke-dashoffset="500"/>
            <circle cx="290" cy="14" r="9" fill="var(--green)"/>
            <circle cx="290" cy="14" r="16" fill="rgba(61,255,154,0.1)" class="vring-anim"/>
            <circle cx="72" cy="28" r="6" fill="#4D9EFF"/>
            <circle cx="175" cy="56" r="4.5" fill="rgba(74,98,88,0.5)"/>
            <circle cx="20" cy="64" r="3.5" fill="var(--green)" opacity="0.4"/>
          </svg>
        </div>
      </div>

      <!-- Card 2: Medium — Geofencing -->
      <div class="bcard bcard-md">
        <div class="feat-icon blue-icon" style="margin-bottom:20px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4D9EFF" stroke-width="2"><path d="M12 22s8-4.5 8-11.8A8 8 0 0 0 12 2a8 8 0 0 0-8 8.2c0 7.3 8 11.8 8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <h3 class="feat-title">Geofencing</h3>
        <p class="feat-desc">Zones virtuelles avec alertes d'entrée et sortie automatiques. Drag & drop sur la carte.</p>
        <div class="geo-viz">
          <div class="geo-ring geo-r1"></div>
          <div class="geo-ring geo-r2"></div>
          <div class="geo-core">
            <span class="ping-anim" style="position:absolute;inset:0;border-radius:50%;background:#4D9EFF;opacity:0.3;"></span>
            <span style="position:relative;width:10px;height:10px;border-radius:50%;background:#4D9EFF;display:block;"></span>
          </div>
          <div class="geo-badge">
            <span style="width:6px;height:6px;border-radius:50%;background:var(--green);display:block;"></span>
            <span style="font-size:9px;color:var(--green);">ENTRÉ</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Medium — Alerts -->
      <div class="bcard bcard-md">
        <div class="feat-icon red-icon" style="margin-bottom:20px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </div>
        <h3 class="feat-title">Alertes intelligentes</h3>
        <p class="feat-desc">Push, WhatsApp, SMS — pour geofence, batterie faible et vitesse excessive.</p>
        <div style="margin-top:20px;display:flex;flex-direction:column;gap:8px;">
          <div class="alert-chip" style="--chip-color:var(--red);">
            <span class="mono" style="color:var(--red);font-size:9px;">ALERTE</span>
            <span>Sortie de zone — Camion-01</span>
          </div>
          <div class="alert-chip" style="--chip-color:var(--amber);">
            <span class="mono" style="color:var(--amber);font-size:9px;">VITESSE</span>
            <span>Excessive — 94 km/h</span>
          </div>
          <div class="alert-chip" style="--chip-color:var(--blue);">
            <span class="mono" style="color:var(--blue);font-size:9px;">ZONE</span>
            <span>Entrée — Bureau Central</span>
          </div>
        </div>
      </div>

      <!-- Card 4: Large — Reports -->
      <div class="bcard bcard-lg">
        <div class="feat-icon amber-icon" style="margin-bottom:20px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8M16 17H8"/></svg>
        </div>
        <h3 class="feat-title">Rapports détaillés</h3>
        <p class="feat-desc">Distance parcourue, temps d'inactivité, violations de vitesse, historique des trajets. Exportable CSV.</p>
        <div class="feat-viz">
          <div class="mono" style="font-size:9px;color:var(--text-muted);margin-bottom:10px;letter-spacing:0.06em;">DISTANCE (km) — 7 DERNIERS JOURS</div>
          <div class="bar-chart">
            <div class="bar" style="--h:40%;--c:rgba(255,184,48,0.25);" title="Lun">
              <span class="bar-val mono">87</span>
            </div>
            <div class="bar" style="--h:65%;--c:rgba(255,184,48,0.4);" title="Mar">
              <span class="bar-val mono">142</span>
            </div>
            <div class="bar" style="--h:50%;--c:rgba(255,184,48,0.3);" title="Mer">
              <span class="bar-val mono">109</span>
            </div>
            <div class="bar" style="--h:85%;--c:rgba(255,184,48,0.55);" title="Jeu">
              <span class="bar-val mono">185</span>
            </div>
            <div class="bar" style="--h:70%;--c:rgba(255,184,48,0.45);" title="Ven">
              <span class="bar-val mono">153</span>
            </div>
            <div class="bar" style="--h:100%;--c:var(--amber);" title="Sam">
              <span class="bar-val mono">218</span>
            </div>
            <div class="bar" style="--h:78%;--c:rgba(255,184,48,0.5);" title="Dim">
              <span class="bar-val mono">170</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 5: Medium — PWA -->
      <div class="bcard bcard-md">
