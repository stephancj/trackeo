.hl-green {
  font-size: clamp(3.5rem, 8vw, 7rem);
  color: var(--green);
}

.hero-sub {
  color: var(--text-muted);
  font-size: 16px;
  line-height: 1.65;
  max-width: 420px;
  margin-bottom: 36px;
}
.hero-sub strong { color: var(--text); font-weight: 600; }

/* CTA buttons */
.hero-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 40px;
}
.cta-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 26px;
  border-radius: 10px;
  background: var(--green);
  color: #030508;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  transition: all 0.2s;
  letter-spacing: 0.02em;
}
.cta-primary:hover {
  background: #5DFFA8;
  box-shadow: 0 0 48px rgba(61, 255, 154, 0.4);
}
.cta-ghost {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 26px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.04);
  color: var(--text);
  font-weight: 600;
  font-size: 14px;
  text-decoration: none;
  border: 1px solid var(--border-subtle);
  transition: all 0.2s;
}
.cta-ghost:hover {
  background: rgba(255, 255, 255, 0.07);
  border-color: var(--border);
}

/* Metrics strip */
.hero-metrics {
  display: flex;
  align-items: center;
  gap: 0;
  padding: 16px 0;
  border-top: 1px solid var(--border-subtle);
}
.metric { padding: 0 24px; }
.metric:first-child { padding-left: 0; }
.metric-val {
  display: block;
  font-size: 20px;
  font-weight: 700;
  color: white;
  line-height: 1;
  margin-bottom: 4px;
}
.metric-lbl {
  font-size: 11px;
  color: var(--text-muted);
  letter-spacing: 0.04em;
}
.metric-sep {
  width: 1px;
  height: 32px;
  background: var(--border-subtle);
  flex-shrink: 0;
}

/* ══════════════════════════════════════════
   DASHBOARD CARD
══════════════════════════════════════════ */
.hero-right {
  position: relative;
  width: 100%;
}
.stat-float {
  position: absolute;
  z-index: 20;
  background: rgba(14, 20, 28, 0.95);
  backdrop-filter: blur(20px);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  padding: 12px 16px;
  display: flex;
  flex-direction: column;
}
.stat-f1 { top: -16px; right: -10px; min-width: 80px; }
.stat-f2 { bottom: 40px; left: -20px; }
@media (max-width: 640px) {
  .stat-float { display: none; }
}
.dash-card {
  position: relative;
  background: var(--surface-2);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 32px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(61, 255, 154, 0.05);
}
.dash-chrome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  background: var(--surface-3);
  border-bottom: 1px solid var(--border-subtle);
}
.chrome-dots {
  display: flex;
  gap: 6px;
}
.chrome-dots span {
  width: 11px; height: 11px;
  border-radius: 50%;
  display: block;
}
.chrome-live {
  display: flex;
  align-items: center;
  gap: 5px;
}
.dash-map-area {
  position: relative;
  height: 260px;
  overflow: hidden;
}
.map-svg {
  width: 100%;
  height: 100%;
  display: block;
}
/* Animated GPS route */
.route-animated {
  animation: route-draw 2.5s ease-out 0.5s forwards;
}
/* Vehicle ring pulse */
@keyframes vring {
  0% { r: 18; opacity: 0.3; }
  100% { r: 28; opacity: 0; }
}
.vring-anim {
  animation: vring 2s ease-out infinite;
}
.vring-anim2 {
  animation: vring 2.5s ease-out infinite 0.8s;
}
@keyframes bento-route-draw {
  from { stroke-dashoffset: 500; }
  to { stroke-dashoffset: 0; }
}
.bento-route {
  animation: bento-route-draw 2s ease-out 0.8s forwards;
}
/* Telemetry + alert overlays */
.telem-card {
  position: absolute;
  background: rgba(8, 12, 17, 0.92);
  backdrop-filter: blur(12px);
  border: 1px solid var(--border-subtle);
  border-radius: 10px;
  padding: 10px 12px;
  min-width: 140px;
}
.telem-header {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 8px;
}
.telem-data {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.telem-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  font-size: 11px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}
.alert-card {
  position: absolute;
  background: rgba(8, 12, 17, 0.92);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(77, 158, 255, 0.2);
  border-radius: 10px;
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  max-width: 240px;
}
.alert-icon {
  width: 28px; height: 28px;
  border-radius: 8px;
  background: rgba(77, 158, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
/* Vehicle strip */
.vehicle-strip {
  display: flex;
  align-items: center;
  padding: 12px 16px;
  gap: 0;
  border-top: 1px solid var(--border-subtle);
  background: var(--surface-3);
}
.vstrip-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
}
.vstrip-sep {
  width: 1px;
  height: 28px;
  background: var(--border-subtle);
  margin: 0 12px;
  flex-shrink: 0;
}
.vstatus {
  width: 8px; height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.vstatus.active { background: var(--green); box-shadow: 0 0 8px var(--green); }
.vstatus.idle { background: #4D9EFF; box-shadow: 0 0 8px #4D9EFF; }
.vstatus.offline { background: var(--text-dim); }

/* Scroll cue */
.scroll-cue {
  position: absolute;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  opacity: 0.35;
}
.scroll-line {
  width: 1px;
  height: 40px;
  background: linear-gradient(to bottom, transparent, var(--green));
  animation: float 2s ease-in-out infinite;
}

/* ══════════════════════════════════════════
   TICKER
══════════════════════════════════════════ */
.ticker-bar {
  display: flex;
  align-items: stretch;
  border-top: 1px solid var(--border-subtle);
  border-bottom: 1px solid var(--border-subtle);
  background: var(--surface);
  height: 44px;
  overflow: hidden;
  user-select: none;
}
.ticker-label {
  display: flex;
  align-items: center;
  padding: 0 18px;
  font-size: 10px;
  font-weight: 700;
  color: var(--green);
  letter-spacing: 0.12em;
  background: var(--green-dim);
  border-right: 1px solid var(--border);
  white-space: nowrap;
  flex-shrink: 0;
}
.ticker-track {
  flex: 1;
  overflow: hidden;
  display: flex;
  align-items: center;
}
.ticker-inner {
  display: flex;
  align-items: center;
  white-space: nowrap;
  animation: ticker-scroll 40s linear infinite;
}
.titem {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-right: 48px;
  font-size: 12px;
  color: var(--text-muted);
}
.titem .mono { font-family: var(--font-mono); font-size: 11px; }
.tdot {
  width: 5px; height: 5px;
  border-radius: 50%;
  flex-shrink: 0;
}
.tdot.green { background: var(--green); }
.tdot.blue { background: #4D9EFF; }
.tdot.amber { background: var(--amber); }
.tdot.red { background: var(--red); }

/* ══════════════════════════════════════════
   BENTO FEATURES
══════════════════════════════════════════ */
.bento-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16px;
}
.bcard {
  background: var(--surface);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  padding: 28px;
  transition: border-color 0.3s;
  position: relative;
  overflow: hidden;
}
.bcard::before {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 80px; height: 80px;
  background: radial-gradient(circle at top right, rgba(61,255,154,0.04), transparent 70%);
}
.bcard:hover { border-color: var(--border); }
.bcard-lg { grid-column: span 3; }
.bcard-md { grid-column: span 2; }
@media (max-width: 1024px) {
  .bcard-lg { grid-column: span 6; }
  .bcard-md { grid-column: span 3; }
}
@media (max-width: 640px) {
  .bcard-md { grid-column: span 6; }
}
.bcard-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20px;
}
.live-badge {
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 700;
  color: var(--green);
  background: var(--green-dim);
  border: 1px solid var(--border);
  padding: 3px 8px;
  border-radius: 3px;
  letter-spacing: 0.1em;
  animation: blink 2s ease-in-out infinite;
}
/* Feature icons */
.feat-icon {
  width: 44px; height: 44px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.green-icon { background: rgba(61, 255, 154, 0.1); }
.blue-icon { background: rgba(77, 158, 255, 0.1); }
.red-icon { background: rgba(255, 77, 77, 0.1); }
.amber-icon { background: rgba(255, 184, 48, 0.1); }
.purple-icon { background: rgba(167, 139, 250, 0.1); }
.pink-icon { background: rgba(244, 114, 182, 0.1); }
.feat-title {
  font-family: var(--font-display);
  font-size: 1.4rem;
  letter-spacing: 0.03em;
  color: white;
  margin-bottom: 10px;
  line-height: 1;
}
.feat-desc {
  color: var(--text-muted);
  font-size: 14px;
  line-height: 1.6;
}
.feat-viz {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid var(--border-subtle);
}
/* Bar chart */
.bar-chart {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  height: 60px;
}
.bar {
  flex: 1;
  height: var(--h);
  background: var(--c);
  border-radius: 4px 4px 0 0;
  position: relative;
  animation: bar-grow 1.2s ease-out;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}
.bar-val {
  font-size: 0; /* hide by default */
  position: absolute;
  top: -16px;
  color: var(--text-muted);
}
/* Alert chips */
.alert-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 6px;
  border: 1px solid rgba(from var(--chip-color) r g b / 0.2);
  background: rgba(from var(--chip-color) r g b / 0.06);
  font-size: 12px;
  color: var(--text-muted);
}
/* Geo animation */
.geo-viz {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80px;
  margin-top: 20px;
}
.geo-ring {
  position: absolute;
  border-radius: 50%;
  border: 1.5px dashed rgba(77, 158, 255, 0.4);
}
.geo-r1 { width: 60px; height: 60px; }
.geo-r2 { width: 96px; height: 96px; opacity: 0.3; }
.geo-core {
  width: 60px; height: 60px;
  border-radius: 50%;
  border: 1.5px dashed rgba(77, 158, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.geo-badge {
  position: absolute;
  top: 4px;
  right: calc(50% - 54px);
  display: flex;
  align-items: center;
  gap: 4px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 3px 7px;
  font-family: var(--font-mono);
}
/* Compat tags */
.compat-tag, .platform-tag {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  border: 1px solid var(--border-subtle);
  border-radius: 4px;
  padding: 4px 10px;
  letter-spacing: 0.04em;
}
.compat-tag:hover, .platform-tag:hover { border-color: var(--border); color: var(--text); }

/* ══════════════════════════════════════════
   STATS BAR
══════════════════════════════════════════ */
.stats-bar {
  padding: 56px 0;
  background: var(--surface);
  border-top: 1px solid var(--border-subtle);
  border-bottom: 1px solid var(--border-subtle);
}
.stats-grid {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0;
}
.stat-block {
  text-align: center;
  padding: 0 56px;
}
.stat-num {
  font-family: var(--font-display);
  font-size: clamp(3rem, 6vw, 5rem);
  color: white;
  line-height: 1;
  letter-spacing: 0.04em;
}
.stat-lbl {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 8px;
  letter-spacing: 0.04em;
}
.stat-divider {
  width: 1px;
  height: 56px;
  background: var(--border-subtle);
  flex-shrink: 0;
}
@media (max-width: 768px) {
  .stat-block { padding: 20px 32px; }
  .stat-divider { display: none; }
}

/* ══════════════════════════════════════════
   HOW IT WORKS / STEPS
══════════════════════════════════════════ */
.steps-grid {
  display: flex;
  align-items: center;
  gap: 0;
}
@media (max-width: 900px) {
  .steps-grid { flex-direction: column; }
  .step-connector { transform: rotate(90deg); }
}
.step-card {
  flex: 1;
  background: var(--surface-2);
  border: 1px solid var(--card-border, var(--border-subtle));
  border-radius: 16px;
  padding: 32px 28px;
  position: relative;
  overflow: hidden;
  transition: border-color 0.3s;
}
.step-card:hover { border-color: var(--border); }
.step-num {
  font-family: var(--font-display);
  font-size: 5rem;
  color: rgba(255, 255, 255, 0.06);
  position: absolute;
  top: 16px;
  right: 20px;
  line-height: 1;
  pointer-events: none;
  letter-spacing: 0.04em;
}
.step-title {
  font-family: var(--font-display);
  font-size: 1.5rem;
  color: white;
  margin-bottom: 12px;
  letter-spacing: 0.03em;
  line-height: 1;
}
.step-desc {
  color: var(--text-muted);
  font-size: 13px;
  line-height: 1.65;
  margin-bottom: 20px;
}
.step-proof {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: 8px;
  background: var(--surface);
  border: 1px solid var(--proof-border, var(--border-subtle));
}
.step-connector {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 0 8px;
  flex-shrink: 0;
}
.connector-line {
  width: 32px;
  height: 1px;
  background: var(--border);
}
.connector-arrow {
  font-size: 14px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

/* ══════════════════════════════════════════
   PRICING
══════════════════════════════════════════ */
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  align-items: stretch;
}
@media (max-width: 900px) {
  .pricing-grid { grid-template-columns: 1fr; max-width: 440px; margin: 0 auto; }
}
.plan-card {
  background: var(--surface);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  padding: 32px 28px;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: border-color 0.3s;
}
.plan-card:hover { border-color: var(--border); }
.plan-featured {
  background: var(--surface-2);
  border-color: var(--border);
  box-shadow: 0 0 0 1px var(--border), 0 24px 64px rgba(61, 255, 154, 0.08);
}
.plan-badge {
  position: absolute;
  top: -13px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--green);
  color: #030508;
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 3px;
  letter-spacing: 0.12em;
  white-space: nowrap;
}
.plan-tier {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  color: var(--text-muted);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 16px;
}
.plan-price {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  margin-bottom: 6px;
}
.price-num {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 5vw, 3.5rem);
  color: white;
  line-height: 1;
  letter-spacing: 0.04em;
}
.plan-desc {
  font-size: 12px;
  color: var(--text-dim);
  margin-bottom: 24px;
  font-family: var(--font-mono);
}
.plan-feats {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 28px;
  flex: 1;
}
.pf {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
}
.pf-on { color: var(--text); }
.pf-on span:first-child { color: var(--green); font-family: var(--font-mono); font-size: 12px; }
.pf-off { color: var(--text-dim); }
.pf-off span:first-child { color: var(--text-dim); font-family: var(--font-mono); font-size: 12px; }
.plan-btn {
  display: block;
  text-align: center;
  padding: 13px 20px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  transition: all 0.2s;
  font-family: var(--font-display);
  font-size: 16px;
  letter-spacing: 0.04em;
}
.plan-btn-primary {
  background: var(--green);
  color: #030508;
}
.plan-btn-primary:hover {
  background: #5DFFA8;
  box-shadow: 0 0 40px rgba(61, 255, 154, 0.3);
}
.plan-btn-ghost {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--border-subtle);
}
.plan-btn-ghost:hover {
  background: rgba(255, 255, 255, 0.04);
  border-color: var(--border);
}

/* ══════════════════════════════════════════
   CTA SECTION
══════════════════════════════════════════ */
.cta-section {
  position: relative;
  padding: 140px 0;
  overflow: hidden;
  background: var(--surface);
}
.cta-bg {
  position: absolute;
  inset: 0;
  opacity: 0.4;
}
.cta-orb {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 900px;
  height: 400px;
  border-radius: 50%;
  background: var(--green);
  filter: blur(180px);
  opacity: 0.05;
  pointer-events: none;
}
.coord-corner {
  position: absolute;
  font-size: 10px;
  color: var(--text-dim);
  letter-spacing: 0.08em;
}
.top-left { top: 20px; left: 28px; }
.top-right { top: 20px; right: 28px; }
.bottom-left { bottom: 20px; left: 28px; }
.bottom-right { bottom: 20px; right: 28px; }
.cta-title {
  font-family: var(--font-display);
  font-size: clamp(3rem, 7vw, 6rem);
  color: white;
  line-height: 1;
  letter-spacing: 0.04em;
  margin-bottom: 20px;
}
.cta-sub {
  color: var(--text-muted);
  font-size: 16px;
  line-height: 1.65;
  margin-bottom: 48px;
}
.cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 18px 40px;
  border-radius: 12px;
  background: var(--green);
  color: #030508;
  font-family: var(--font-display);
  font-size: 22px;
  letter-spacing: 0.06em;
  text-decoration: none;
  transition: all 0.3s;
}
.cta-btn:hover {
  background: #5DFFA8;
  box-shadow: 0 0 80px rgba(61, 255, 154, 0.4);
  transform: translateY(-2px);
}

/* ══════════════════════════════════════════
   FOOTER
══════════════════════════════════════════ */
.footer {
  border-top: 1px solid var(--border-subtle);
  background: var(--bg);
  padding: 64px 0 40px;
}
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 48px;
  margin-bottom: 48px;
}
@media (max-width: 768px) {
  .footer-grid { grid-template-columns: 1fr; }
}
.footer-brand {}
.footer-logo {
  display: flex;
  align-items: center;
  gap: 10px;
}
.footer-col {}
.footer-col-title {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  color: var(--text-dim);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 20px;
}
.footer-link {
  display: block;
  font-size: 14px;
  color: var(--text-muted);
  text-decoration: none;
  margin-bottom: 12px;
  transition: color 0.2s;
}
.footer-link:hover { color: var(--text); }
.footer-info {
  display: block;
  font-size: 14px;
  color: var(--text-dim);
  margin-bottom: 12px;
}
.footer-bottom {
  padding-top: 32px;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  font-size: 12px;
  color: var(--text-dim);
}
</style>

<script>
// Animate bars on scroll into view
const observer = new IntersectionObserver((entries) => {
  entries.forEach(el => {
    if (el.isIntersecting) el.target.classList.add('in-view');
  });
}, { threshold: 0.1 });

document.querySelectorAll('.bcard, .step-card, .plan-card').forEach(el => observer.observe(el));
</script>
