---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Trackeo - Suivi GPS en temps réel">
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Background Effects -->
    <div class="absolute inset-0 grid-pattern"></div>
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-[#4ECB8D] rounded-full blur-[150px] opacity-20 animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-[#5B8DEF] rounded-full blur-[150px] opacity-15 animate-pulse" style="animation-delay: 2s;"></div>
    
    <!-- Floating Particles -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="particle animate-float" style="top: 20%; left: 10%; animation-delay: 0s;"></div>
      <div class="particle animate-float" style="top: 60%; left: 20%; animation-delay: 1s;"></div>
      <div class="particle animate-float" style="top: 30%; left: 80%; animation-delay: 2s;"></div>
      <div class="particle animate-float" style="top: 70%; left: 70%; animation-delay: 3s;"></div>
      <div class="particle animate-float" style="top: 40%; left: 50%; animation-delay: 4s;"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20">
      <div class="text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass mb-8 animate-fade-up">
          <span class="w-2 h-2 bg-[#4ECB8D] rounded-full animate-pulse"></span>
          <span class="text-sm text-[#9CA3AF]">Solution de tracking #1 à Madagascar</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-5xl md:text-7xl font-bold mb-6 animate-fade-up delay-100">
          <span class="text-white">Gardez un </span>
          <span class="gradient-text">œil</span>
          <span class="text-white"> sur vos véhicules</span>
        </h1>
        
        <p class="text-xl md:text-2xl text-[#9CA3AF] max-w-3xl mx-auto mb-12 animate-fade-up delay-200">
          Suivi GPS en temps réel, alertes geofencing, rapports de conduite. 
          Tout ce dont vous avez besoin pour gérer votre flotte.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-up delay-300">
          <a href="https://trackeo.zenkai.mg" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#4ECB8D] text-white font-semibold rounded-xl hover:bg-[#3DB87A] transition-all glow">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
            Essayer gratuitement
          </a>
          <a href="#features" class="inline-flex items-center justify-center gap-2 px-8 py-4 glass text-white font-semibold rounded-xl hover:bg-white/10 transition-all">
            Découvrir les fonctionnalités
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- App Preview Mockup -->
        <div class="mt-20 relative animate-fade-up delay-400">
          <div class="relative mx-auto max-w-4xl">
            <!-- Phone Frame -->
            <div class="relative mx-auto w-72 md:w-80 lg:w-96 aspect-[9/19] rounded-[3rem] overflow-hidden border-4 border-[#333549] shadow-2xl glow">
              <div class="absolute inset-0 bg-[#1A1A25]">
                <!-- App UI Mockup -->
                <div class="h-full flex flex-col">
                  <!-- Status Bar -->
                  <div class="h-14 bg-[#12121A] flex items-center justify-between px-6">
                    <div class="w-16 h-2 bg-[#333549] rounded-full"></div>
                    <div class="flex gap-1">
                      <div class="w-4 h-2 bg-[#333549] rounded-full"></div>
                      <div class="w-4 h-2 bg-[#333549] rounded-full"></div>
                      <div class="w-6 h-2 bg-[#4ECB8D] rounded-full"></div>
                    </div>
                  </div>
                  <!-- Map Area -->
                  <div class="flex-1 relative overflow-hidden">
                    <div class="absolute inset-0 bg-[#1A1A25] grid-pattern opacity-50"></div>
                    <!-- Map Route Line -->
                    <svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                      <path d="M 20 80 Q 40 40 50 60 T 80 30" fill="none" stroke="#4ECB8D" stroke-width="0.5" opacity="0.6"/>
                    </svg>
                    <!-- Moving Car -->
                    <div class="absolute top-[30%] left-[80%] transform -translate-x-1/2 -translate-y-1/2">
                      <div class="relative">
                        <div class="w-8 h-8 bg-[#4ECB8D] rounded-full flex items-center justify-center animate-map-pulse">
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>
                        </div>
                        <div class="absolute inset-0 w-8 h-8 bg-[#4ECB8D] rounded-full animate-pulse-ring"></div>
                      </div>
                    </div>
                    <!-- Geofence Circle -->
                    <div class="absolute top-[60%] left-[40%] w-16 h-16 border-2 border-[#5B8DEF] rounded-full opacity-50"></div>
                  </div>
                  <!-- Bottom Nav -->
                  <div class="h-20 bg-[#12121A] flex items-center justify-around px-4">
                    <div class="flex flex-col items-center gap-1">
                      <div class="w-6 h-6 text-[#4ECB8D]" fill="currentColor"><svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/></svg></div>
                      <div class="w-8 h-1 bg-[#4ECB8D] rounded-full"></div>
                    </div>
                    <div class="flex flex-col items-center gap-1 opacity-50">
                      <div class="w-6 h-6"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3z"/><path d="M9 3v18"/><path d="M3 9h18"/></svg></div>
                    </div>
                    <div class="flex flex-col items-center gap-1 opacity-50">
                      <div class="w-6 h-6"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4.5 8-11.8A8 8 0 0 0 12 2a8 8 0 0 0-8 8.2c0 7.3 8 11.8 8 11.8z"/><circle cx="12" cy="10" r="3"/></svg></div>
                    </div>
                    <div class="flex flex-col items-center gap-1 opacity-50">
                      <div class="w-6 h-6"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Floating Elements around phone -->
            <div class="absolute -left-20 top-1/4 glass rounded-2xl p-4 animate-float hidden lg:block">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-[#4ECB8D] rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-white">Alertes en temps réel</div>
                  <div class="text-xs text-[#9CA3AF]">Push & WhatsApp</div>
                </div>
              </div>
            </div>
            
            <div class="absolute -right-20 bottom-1/4 glass rounded-2xl p-4 animate-float hidden lg:block" style="animation-delay: 2s;">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-[#5B8DEF] rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4.5 8-11.8A8 8 0 0 0 12 2a8 8 0 0 0-8 8.2c0 7.3 8 11.8 8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-white">Geofencing</div>
                  <div class="text-xs text-[#9CA3AF]">Alertes entrée/sortie</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#9CA3AF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-32 relative">
    <div class="absolute inset-0 bg-[#12121A]"></div>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="text-center mb-20">
        <span class="text-[#4ECB8D] font-medium">FONCTIONNALITÉS</span>
        <h2 class="text-4xl md:text-5xl font-bold mt-4 mb-6">Tout ce dont vous avez besoin</h2>
        <p class="text-xl text-[#9CA3AF] max-w-2xl mx-auto">
          Une solution complète pour gérer votre flotte de véhicules en toute simplicité.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="glass rounded-2xl p-8 card-glow animate-fade-up">
          <div class="w-14 h-14 bg-[#4ECB8D]/20 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#4ECB8D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Suivi en temps réel</h3>
          <p class="text-[#9CA3AF]">Visualisez la position de tous vos véhicules sur une carte interactive. Mises à jour toutes les 10 secondes.</p>
        </div>

        <!-- Feature 2 -->
        <div class="glass rounded-2xl p-8 card-glow animate-fade-up delay-100">
          <div class="w-14 h-14 bg-[#5B8DEF]/20 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#5B8DEF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4.5 8-11.8A8 8 0 0 0 12 2a8 8 0 0 0-8 8.2c0 7.3 8 11.8 8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Geofencing intelligent</h3>
          <p class="text-[#9CA3AF]">Créez des zones virtuelles et recevez des alertes instantanées lors des entrées et sorties.</p>
        </div>

        <!-- Feature 3 -->
        <div class="glass rounded-2xl p-8 card-glow animate-fade-up delay-200">
          <div class="w-14 h-14 bg-[#F59E0B]/20 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#F59E0B]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Rapports détaillés</h3>
          <p class="text-[#9CA3AF]">Distance parcourue, temps d'inactivité, violations de vitesse. Des statistiques complètes pour optimiser vos opérations.</p>
        </div>

        <!-- Feature 4 -->
        <div class="glass rounded-2xl p-8 card-glow animate-fade-up delay-300">
          <div class="w-14 h-14 bg-[#EF4444]/20 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#EF4444]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Alertes intelligentes</h3>
          <p class="text-[#9CA3AF]">Notifications push, WhatsApp ou SMS pour les alertes de geofence, batterie faible, vitesse excessive et plus encore.</p>
        </div>

        <!-- Feature 5 -->
        <div class="glass rounded-2xl p-8 card-glow animate-fade-up delay-400">
          <div class="w-14 h-14 bg-[#8B5CF6]/20 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#8B5CF6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Application mobile PWA</h3>
          <p class="text-[#9CA3AF]">Accédez à votre flotte depuis n'importe où via votre navigateur ou installez l'app sur votre téléphone.</p>
        </div>

        <!-- Feature 6 -->
        <div class="glass rounded-2xl p-8 card-glow animate-fade-up delay-500">
          <div class="w-14 h-14 bg-[#EC4899]/20 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#EC4899]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">Compatible tous appareils</h3>
          <p class="text-[#9CA3AF]">Fonctionne avec la plupart des traceurs GPS du marché. Installation rapide et configuration simple.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-[#4ECB8D]/10 to-[#5B8DEF]/10"></div>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="grid md:grid-cols-4 gap-8">
        <div class="text-center animate-fade-up">
          <div class="text-5xl font-bold gradient-text mb-2">99.9%</div>
          <div class="text-[#9CA3AF]">Uptime garanti</div>
        </div>
        <div class="text-center animate-fade-up delay-100">
          <div class="text-5xl font-bold gradient-text mb-2">500+</div>
          <div class="text-[#9CA3AF]">Véhicules suivis</div>
        </div>
        <div class="text-center animate-fade-up delay-200">
          <div class="text-5xl font-bold gradient-text mb-2">24/7</div>
          <div class="text-[#9CA3AF]">Support disponible</div>
        </div>
        <div class="text-center animate-fade-up delay-300">
          <div class="text-5xl font-bold gradient-text mb-2">50K+</div>
          <div class="text-[#9CA3AF]">Positions/jour</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-32 relative">
    <div class="absolute inset-0 bg-[#12121A]"></div>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="text-center mb-20">
        <span class="text-[#4ECB8D] font-medium">COMMENT ÇA MARCHE</span>
        <h2 class="text-4xl md:text-5xl font-bold mt-4 mb-6">En 3 étapes simples</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-12">
        <div class="relative text-center animate-fade-up">
          <div class="w-20 h-20 bg-[#4ECB8D] rounded-full flex items-center justify-center mx-auto mb-6 relative">
            <span class="text-3xl font-bold text-white">1</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Installez le tracker</h3>
          <p class="text-[#9CA3AF]">Connectez le traceur GPS à votre véhicule. Compatible avec la plupart des appareils du marché.</p>
        </div>

        <div class="relative text-center animate-fade-up delay-200">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-32 h-0.5 bg-gradient-to-r from-transparent via-[#4ECB8D] to-transparent hidden md:block"></div>
          <div class="w-20 h-20 bg-[#4ECB8D] rounded-full flex items-center justify-center mx-auto mb-6 relative">
            <span class="text-3xl font-bold text-white">2</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Créez votre compte</h3>
          <p class="text-[#9CA3AF]">Inscrivez-vous et ajoutez vos véhicules. L'interface intuitive vous guide étape par étape.</p>
        </div>

        <div class="relative text-center animate-fade-up delay-400">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-32 h-0.5 bg-gradient-to-r from-transparent via-[#4ECB8D] to-transparent hidden md:block"></div>
          <div class="w-20 h-20 bg-[#4ECB8D] rounded-full flex items-center justify-center mx-auto mb-6 relative">
            <span class="text-3xl font-bold text-white">3</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Suivez en temps réel</h3>
          <p class="text-[#9CA3AF]">Accédez à votre tableau de bord et gardez un œil sur tous vos véhicules en temps réel.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-32 relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-[#4ECB8D] rounded-full blur-[200px] opacity-20"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-[#5B8DEF] rounded-full blur-[200px] opacity-15"></div>
    </div>
    <div class="max-w-4xl mx-auto px-6 relative z-10 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">Prêt à démarrer?</h2>
      <p class="text-xl text-[#9CA3AF] mb-12">
        Rejoignez les milliers de propriétaires qui font confiance à Trackeo pour sécuriser leur flotte.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://trackeo.zenkai.mg" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#4ECB8D] text-white font-semibold rounded-xl hover:bg-[#3DB87A] transition-all glow">
          Commencer maintenant
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-12 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-[#4ECB8D] rounded-xl flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <span class="text-xl font-bold">Trackeo</span>
        </div>
        <div class="text-[#9CA3AF] text-sm">
          © 2026 Trackeo. Tous droits réservés.
        </div>
        <div class="flex gap-4">
          <a href="https://trackeo.zenkai.mg" class="text-[#9CA3AF] hover:text-[#4ECB8D] transition-colors">
