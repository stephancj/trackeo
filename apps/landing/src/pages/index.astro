---
import Layout from '../layouts/Layout.astro';

const heroSignals = [
  'Suivi GPS en direct toutes les 10 secondes',
  'Historique brut, trip log, idle time, vitesse et geofences',
  'Push OneSignal et alertes WhatsApp ciblees',
  'PWA mobile first, sans App Store',
  'Back-office admin pour users, devices, alertes et abonnements',
  'Compatibilite Traccar pour 900+ protocoles GPS',
];

const operationalFeatures = [
  {
    slug: 'live',
    kicker: 'Suivi en direct',
    title: 'Voir la flotte telle qu\'elle roule vraiment',
    description:
      'Trackeo montre sur la carte la position, la vitesse, la batterie, le signal et le statut de chaque véhicule sans bruit visuel inutile.',
    bullets: [
      'Vue flotte et détail véhicule depuis la même PWA',
      'Statut online, arrêté ou hors ligne en lecture immédiate',
      'Recherche par nom, plaque ou numéro de série',
    ],
    stat: '10 s',
    note: 'Polling stable pour le MVP Flutter Web',
    tone: 'mint',
  },
  {
    slug: 'history',
    kicker: 'Historique et rapports',
    title: 'Comprendre le trajet, pas seulement le point GPS',
    description:
      'L\'historique dessine la trace, reconstruit les segments utiles et résume distance, durée, vitesse max, idle time et activité par geofence.',
    bullets: [
      'Trip log reconstitué depuis tc_positions',
      'Résumé distance, inactivité, vitesse excessive',
      'Lecture cohérente côté client et côté admin',
    ],
    stat: '30 jours',
    note: 'Fenêtre claire pour les requêtes et le diagnostic',
    tone: 'amber',
  },
  {
    slug: 'alerts',
    kicker: 'Geofences et alertes',
    title: 'Recevoir le bon signal avant l\'appel du chauffeur',
    description:
      'Zones d\'entrée et de sortie, batterie faible, vitesse excessive, push, WhatsApp et réglages par utilisateur font partie du flux normal du produit.',
    bullets: [
      'Création de zone cercle depuis la carte',
      'Alertes ciblées via subscription ID OneSignal',
      'Ack, visibilité et statistiques dans le back-office',
    ],
    stat: '30 s',
    note: 'Cron de contrôle et cache anti-spam côté backend',
    tone: 'blue',
  },
  {
    slug: 'ops',
    kicker: 'Exploitation et admin',
    title: 'Le terrain et le support lisent la même vérité',
    description:
      'Le dashboard admin couvre utilisateurs, devices, geofences, alertes, rapports, abonnements et configuration sans séparer le support du produit réel.',
    bullets: [
      'Assignation device vers utilisateur',
      'Rapports globaux et détail par véhicule',
      'Gestion des plans, statuts et paramètres système',
    ],
    stat: '7 modules',
    note: 'Une seule plateforme pour l\'exploitation et le support',
    tone: 'ink',
  },
  {
    slug: 'reach',
    kicker: 'Déploiement simple',
    title: 'Ouvrir partout aujourd\'hui, étendre demain sans réécrire',
    description:
      'La PWA Flutter permet un accès immédiat sur web, mobile ou desktop, pendant que Traccar gère la diversité des traceurs et prépare la suite native.',
    bullets: [
      'Flutter Web maintenant, mobile natif ensuite',
      'Compatible Teltonika, Coban, GT06, Sinotrack et autres',
      'Workflow local first pour tester avant le VPS',
    ],
    stat: '+900',
    note: 'Protocoles pris en charge par Traccar',
    tone: 'paper',
  },
];

const roadmapPhases = [
  {
    label: 'En service',
    title: 'Le coeur du produit est déjà en ligne',
    copy:
      'La proposition Trackeo existe aujourd\'hui: live tracking, historique, rapports, geofences, alertes multi-canales, administration et plans.',
    items: [
      'Tracking en direct avec statuts, batterie et signal',
      'Historique trajet, trip log, vitesse, idle et activité geofence',
      'Push OneSignal, WhatsApp, réglages d\'alerte par utilisateur',
      'Admin users, devices, alerts, reports, subscriptions et settings',
    ],
    tone: 'mint',
  },
  {
    label: 'Prochaine vague',
    title: 'Rendre l\'activation et la réaction encore plus fluides',
    copy:
      'La prochaine étape rapproche le produit du terrain: onboarding plus net, support plus rapide, sécurité mieux orchestrée.',
    items: [
      'Activation appareil par QR ou OTP',
      'Mode vol, partage live et escalade support',
      'Flow installateur avec VIN et photos de pose',
      'Abonnements plus complets et parcours d\'activation améliorés',
    ],
    tone: 'blue',
  },
  {
    label: 'Extension',
    title: 'Passer de la flotte suivie à la flotte opérée',
    copy:
      'La vision produit s\'élargit vers la télémétrie, la livraison, les partenaires et le natif mobile sans perdre la même base.',
    items: [
      'Carburant, distance agrégée et exports avancés',
      'Livraison et collecte avec tracking client',
      'Webhook partenaires, B2B multi-équipe et RBAC',
      'Applications mobiles natives, OTA et analytics avancées',
    ],
    tone: 'amber',
  },
];

const plans = [
  {
    name: 'Gratuit',
    price: '0',
    unit: 'Ariary / mois',
    description: 'Pour tester la plateforme avec un seul véhicule.',
    features: [
      '1 véhicule',
      'Suivi GPS en direct',
      'Alertes push',
      'Accès PWA',
    ],
    tone: 'paper',
  },
  {
    name: 'Basic',
    price: '45K',
    unit: 'Ariary / mois',
    description: 'Pour une petite flotte qui veut géofences, WhatsApp et rapports.',
    features: [
      '5 véhicules',
      'Geofencing complet',
      'Alertes WhatsApp et push',
      'Rapports d\'activité et exports',
    ],
    tone: 'mint',
  },
  {
    name: 'Premium',
    price: 'Sur devis',
    unit: 'B2B et flotte étendue',
    description: 'Pour les équipes qui veulent le back-office complet et une montée en charge accompagnée.',
    features: [
      'Véhicules illimités',
      'Tout Basic inclus',
      'Support prioritaire',
      'Administration et intégration avancées',
    ],
    tone: 'ink',
  },
];

const steps = [
  {
    number: '01',
    title: 'Brancher ou déclarer le traceur',
    text:
      'Traccar permet d\'absorber la diversité des appareils du marché malgache, sans inventer un protocole maison.',
  },
  {
    number: '02',
    title: 'Associer le véhicule au bon compte',
    text:
      'Aujourd\'hui via l\'admin, demain via QR et OTP. Le but reste le même: une activation sans friction.',
  },
  {
    number: '03',
    title: 'Piloter depuis la PWA et le back-office',
    text:
      'Le propriétaire suit sa flotte, le support voit la même chose, l\'admin garde la main sur les devices et les alertes.',
  },
];
---

<Layout title="Trackeo | Tracking GPS clair, rapide et local pour les flottes">
  <header class="site-header">
    <div class="shell header-row">
      <a href="/" class="brand-lockup">
        <span class="brand-mark">
          <img src="/favicon.png" alt="Trackeo" width="22" height="22" />
        </span>
        <span class="brand-copy">
          <strong>Trackeo</strong>
          <span>tracking GPS pensé pour Madagascar</span>
        </span>
      </a>

      <nav class="site-nav" aria-label="Navigation principale">
        <a href="#plateforme">Plateforme</a>
        <a href="#mise-en-route">Démarrage</a>
        <a href="#roadmap">Cap produit</a>
        <a href="#pricing">Tarifs</a>
      </nav>

      <a href="https://trackeo.zenkai.mg" class="button button-dark">Ouvrir la PWA</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy reveal">
          <p class="eyebrow">Une plateforme GPS calme, lisible et prête pour le terrain.</p>
          <h1>
            Voir chaque véhicule, comprendre chaque trajet, recevoir chaque alerte
            avant qu&apos;elle ne devienne un problème.
          </h1>
          <p class="hero-body">
            Trackeo réunit la carte live, l&apos;historique, les geofences, les alertes,
            les rapports et l&apos;administration dans une expérience claire, mobile first
            et adaptée aux réalités d&apos;une flotte à Madagascar.
          </p>

          <div class="hero-actions">
            <a href="https://trackeo.zenkai.mg" class="button button-brand">Essayer la PWA</a>
            <a href="#roadmap" class="button button-ghost">Voir le cap produit</a>
          </div>

          <ul class="hero-proof">
            {heroSignals.map((signal) => (
              <li>
                <span class="proof-dot" aria-hidden="true"></span>
                <span>{signal}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="hero-scene reveal reveal-delay-2">
          <div class="hero-slip hero-slip-top">
            <span class="slip-dot slip-dot-blue"></span>
            <span>Zone “Dépôt Nord” franchie, WhatsApp envoyé en 12 s</span>
          </div>

          <div class="hero-board">
            <div class="hero-top-grid">
              <div class="map-sheet">
                <div class="map-meta">
                  <span class="mini-kicker">Flotte live</span>
                  <span class="mini-pill">Antananarivo centre</span>
                </div>

                <svg viewBox="0 0 640 360" class="route-scene" aria-hidden="true">
                  <defs>
                    <linearGradient id="mint-route" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="var(--brand-strong)" />
                      <stop offset="100%" stop-color="var(--blue)" />
                    </linearGradient>
                  </defs>

                  <g stroke="color-mix(in oklab, var(--ink) 10%, transparent)" stroke-width="1">
                    <line x1="0" y1="90" x2="640" y2="90" />
                    <line x1="0" y1="180" x2="640" y2="180" />
                    <line x1="0" y1="270" x2="640" y2="270" />
                    <line x1="106" y1="0" x2="106" y2="360" />
                    <line x1="228" y1="0" x2="228" y2="360" />
                    <line x1="365" y1="0" x2="365" y2="360" />
                    <line x1="520" y1="0" x2="520" y2="360" />
                  </g>

                  <circle cx="472" cy="110" r="72" fill="color-mix(in oklab, var(--blue) 12%, transparent)" />
                  <circle cx="472" cy="110" r="56" fill="none" stroke="color-mix(in oklab, var(--blue) 50%, white)" stroke-dasharray="5 8" stroke-width="3" />

                  <path
                    d="M 42 286 L 158 286 L 158 210 L 255 210 L 255 160 L 382 160 L 382 110 L 472 110"
                    fill="none"
                    stroke="url(#mint-route)"
                    stroke-width="10"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-dasharray="520"
                    stroke-dashoffset="520"
                    class="route-path"
                  />

                  <circle cx="472" cy="110" r="18" fill="var(--brand-strong)" />
                  <circle cx="472" cy="110" r="38" fill="color-mix(in oklab, var(--brand) 18%, transparent)" class="pulse-ring" />
                  <circle cx="255" cy="210" r="14" fill="var(--blue)" />
                  <circle cx="158" cy="286" r="12" fill="var(--amber)" />
                  <circle cx="42" cy="286" r="10" fill="var(--red)" />
                </svg>

                <div class="map-tag map-tag-main">
                  <strong>Camion-01</strong>
                  <span>72 km/h, batterie 84%, GPS OK</span>
                </div>
                <div class="map-tag map-tag-fence">
                  <strong>Geofence active</strong>
                  <span>Zone Bureau, entrée confirmée</span>
                </div>
              </div>

              <div class="status-rail">
                <div class="status-sheet">
                  <span class="mini-kicker">Statuts</span>
                  <div class="status-line">
                    <span class="tone-dot tone-dot-mint"></span>
                    <div>
                      <strong>3 véhicules actifs</strong>
                      <span>camion, voiture, moto</span>
                    </div>
                  </div>
                  <div class="status-line">
                    <span class="tone-dot tone-dot-blue"></span>
                    <div>
                      <strong>2 en attente</strong>
                      <span>arrêtés mais connectés</span>
                    </div>
                  </div>
                  <div class="status-line">
                    <span class="tone-dot tone-dot-red"></span>
                    <div>
                      <strong>1 batterie faible</strong>
                      <span>alerte générée côté backend</span>
                    </div>
                  </div>
                </div>

                <div class="status-sheet status-sheet-contrast">
                  <span class="mini-kicker">Stack prête</span>
                  <p>
                    Traccar pour l&apos;ingestion, NestJS pour l&apos;API, Flutter Web pour
                    la PWA, Next.js pour l&apos;admin.
                  </p>
                </div>
              </div>
            </div>

            <div class="hero-bottom-grid">
              <div class="feed-sheet">
                <div class="feed-head">
                  <div>
                    <span class="mini-kicker">Flux d&apos;alertes</span>
                    <h2>Push, WhatsApp, support</h2>
                  </div>
                  <span class="mini-pill mini-pill-alert">Temps réel</span>
                </div>

                <ul class="feed-list">
                  <li>
                    <span class="feed-accent feed-accent-blue"></span>
                    <div>
                      <strong>Entrée geofence</strong>
                      <span>Camion-01, Bureau Central, il y a 12 s</span>
                    </div>
                  </li>
                  <li>
                    <span class="feed-accent feed-accent-red"></span>
                    <div>
                      <strong>Batterie faible</strong>
                      <span>Moto-04, 18%, notification envoyée</span>
                    </div>
                  </li>
                  <li>
                    <span class="feed-accent feed-accent-amber"></span>
                    <div>
                      <strong>Vitesse excessive</strong>
                      <span>Voiture-02, 124 km/h, épisode groupé</span>
                    </div>
                  </li>
                </ul>

                <div class="feed-footer">
                  <div>
                    <span class="mini-kicker">Rapport de la semaine</span>
                    <strong>1 234 km parcourus, 4 trajets reconstitués</strong>
                  </div>
                  <span class="mini-pill">CSV prêt</span>
                </div>
              </div>

              <div class="phone-sheet">
                <div class="phone-frame">
                  <div class="phone-screen">
                    <div class="phone-head">
                      <div>
                        <span class="mini-kicker">PWA mobile</span>
                        <strong>Mes véhicules</strong>
                      </div>
                      <span class="phone-badge">3 actifs</span>
                    </div>

                    <div class="phone-card">
                      <div class="phone-row">
                        <div class="phone-icon phone-icon-green"></div>
                        <div>
                          <strong>Camion-01</strong>
                          <span>Analakely, en route</span>
                        </div>
                        <em>72 km/h</em>
                      </div>
                    </div>

                    <div class="phone-card phone-card-secondary">
                      <div class="phone-row">
                        <div class="phone-icon phone-icon-blue"></div>
                        <div>
                          <strong>Voiture-02</strong>
                          <span>Gare routière, arrêtée</span>
                        </div>
                        <em>il y a 2 min</em>
                      </div>
                    </div>

                    <div class="phone-settings">
                      <span class="mini-kicker">Réglages d&apos;alerte</span>
                      <div class="toggle-line">
                        <span>Push</span>
                        <span class="toggle on"></span>
                      </div>
                      <div class="toggle-line">
                        <span>WhatsApp</span>
                        <span class="toggle on"></span>
                      </div>
                      <div class="toggle-line">
                        <span>Vitesse</span>
                        <span class="toggle off"></span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="hero-slip hero-slip-bottom">
            <span class="slip-dot slip-dot-mint"></span>
            <span>Rapports, devices, abonnements et support lisent les mêmes données</span>
          </div>
        </div>
      </div>
    </section>

    <section class="shell signal-bar" aria-label="Résumé des modules Trackeo">
      <div class="signal-card">
        <p>Déjà en service</p>
        <div class="signal-list">
          <span>live tracking</span>
          <span>historique brut</span>
          <span>trip log</span>
          <span>idle time</span>
          <span>vitesse excessive</span>
          <span>geofences</span>
          <span>alertes push</span>
          <span>WhatsApp</span>
          <span>PWA</span>
          <span>admin Next.js</span>
          <span>abonnements</span>
          <span>compatibilité multi-protocoles</span>
        </div>
      </div>
    </section>

    <section class="section" id="plateforme">
      <div class="shell">
        <div class="section-head">
          <p class="eyebrow">La plateforme aujourd&apos;hui</p>
          <h2>Ce que la landing promet doit déjà exister dans le produit.</h2>
          <p>
            La page parle du produit réel, pas d&apos;une vision décorative. Chaque bloc
            ci-dessous s&apos;appuie sur des modules présents dans le monorepo et sur une
            progression honnête vers la suite.
          </p>
        </div>

        <div class="story-stack">
          {operationalFeatures.map((feature, index) => (
            <article class={`story-card tone-${feature.tone} ${index % 2 === 1 ? 'story-reversed' : ''}`}>
              <div class="story-copy">
                <p class="story-kicker">{feature.kicker}</p>
                <h3>{feature.title}</h3>
                <p class="story-description">{feature.description}</p>

                <ul class="story-points">
                  {feature.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>

                <div class="story-meta">
                  <strong>{feature.stat}</strong>
                  <span>{feature.note}</span>
                </div>
              </div>

              <div class={`story-visual visual-${feature.slug}`}>
                {feature.slug === 'live' && (
                  <>
                    <div class="visual-raster">
                      <div class="visual-map-grid"></div>
                      <div class="visual-route visual-route-a"></div>
                      <div class="visual-route visual-route-b"></div>
                      <div class="visual-dot visual-dot-main"></div>
                      <div class="visual-dot visual-dot-blue"></div>
                      <div class="visual-dot visual-dot-amber"></div>
                    </div>
                    <div class="visual-sheet">
                      <div class="sheet-line">
                        <span class="tone-dot tone-dot-mint"></span>
                        <span>Camion-01 en route, 72 km/h</span>
                      </div>
                      <div class="sheet-line">
                        <span class="tone-dot tone-dot-blue"></span>
                        <span>Voiture-02 arrêtée, connectée</span>
                      </div>
                      <div class="sheet-line">
                        <span class="tone-dot tone-dot-red"></span>
                        <span>Bus-03 hors ligne, dernière position reçue</span>
                      </div>
                    </div>
                  </>
                )}

                {feature.slug === 'history' && (
                  <>
                    <div class="history-line">
                      <span></span>
                      <span></span>
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>
                    <div class="history-graph">
                      <div class="history-bar" style="--h: 42%"></div>
                      <div class="history-bar" style="--h: 68%"></div>
                      <div class="history-bar" style="--h: 53%"></div>
                      <div class="history-bar" style="--h: 84%"></div>
                      <div class="history-bar" style="--h: 73%"></div>
                      <div class="history-bar" style="--h: 96%"></div>
                    </div>
                    <div class="history-caption">
                      <strong>Distance, idle, vitesse, geofences</strong>
                      <span>Lecture flotte et lecture admin sur la même base</span>
                    </div>
                  </>
                )}

                {feature.slug === 'alerts' && (
                  <>
                    <div class="bubble bubble-blue">
                      <strong>Entrée zone</strong>
                      <span>Camion-01, Bureau Central</span>
                    </div>
                    <div class="bubble bubble-red">
                      <strong>Batterie faible</strong>
                      <span>Moto-04, 18%, push et WhatsApp</span>
                    </div>
                    <div class="bubble bubble-amber">
                      <strong>Vitesse excessive</strong>
                      <span>Seuil 120 km/h, épisode groupé</span>
                    </div>
                    <div class="settings-grid">
                      <span class="mini-pill">push</span>
                      <span class="mini-pill">WhatsApp</span>
                      <span class="mini-pill">battery</span>
                      <span class="mini-pill">speed</span>
                    </div>
                  </>
                )}

                {feature.slug === 'ops' && (
                  <>
                    <div class="admin-board">
                      <div>
                        <span>Users</span>
                        <strong>liste, détail, désactivation</strong>
                      </div>
                      <div>
                        <span>Devices</span>
                        <strong>assignation et statut</strong>
                      </div>
                      <div>
                        <span>Alerts</span>
                        <strong>ack, filtres, monitoring</strong>
                      </div>
                      <div>
                        <span>Plans</span>
                        <strong>free, basic, premium</strong>
                      </div>
                    </div>
                    <div class="ops-footer">
                      <span>Reports</span>
                      <span>Geofences</span>
                      <span>Settings</span>
                    </div>
                  </>
                )}

                {feature.slug === 'reach' && (
                  <>
                    <div class="reach-cloud">
                      <span>Flutter Web</span>
                      <span>Traccar</span>
                      <span>NestJS</span>
                      <span>Next.js admin</span>
                      <span>TimescaleDB</span>
                      <span>Teltonika</span>
                      <span>Coban</span>
                      <span>GT06</span>
                    </div>
                    <div class="reach-devices">
                      <div class="device desktop"></div>
                      <div class="device phone"></div>
                    </div>
                  </>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-steps" id="mise-en-route">
      <div class="shell">
        <div class="section-head section-head-narrow">
          <p class="eyebrow">Mise en route</p>
          <h2>Le démarrage doit rester simple, même quand la stack est sérieuse.</h2>
        </div>

        <div class="steps-grid">
          {steps.map((step) => (
            <article class="step-panel">
              <span class="step-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="roadmap">
      <div class="shell">
        <div class="section-head">
          <p class="eyebrow">Cap produit</p>
          <h2>Ce qui est déjà prêt, ce qui arrive ensuite, ce qui étend la plateforme.</h2>
          <p>
            La page différencie le présent du futur. Cela rend Trackeo plus crédible,
            surtout pour un produit qui parle sécurité, exploitation et confiance.
          </p>
        </div>

        <div class="roadmap-grid">
          {roadmapPhases.map((phase) => (
            <article class={`phase-card phase-${phase.tone}`}>
              <span class="phase-label">{phase.label}</span>
              <h3>{phase.title}</h3>
              <p>{phase.copy}</p>
              <ul>
                {phase.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section pricing-section" id="pricing">
      <div class="shell">
        <div class="section-head">
          <p class="eyebrow">Tarifs</p>
          <h2>Une structure simple pour démarrer vite, puis monter proprement.</h2>
          <p>
            Les plans reflètent le projet actuel: entrée légère, petite flotte équipée,
            puis accompagnement B2B pour les opérations plus larges.
          </p>
        </div>

        <div class="pricing-grid">
          {plans.map((plan) => (
