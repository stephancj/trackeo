---
import Layout from '../layouts/Layout.astro';

const heroSignals = [
  'Voir vos véhicules bouger en direct sur la carte',
  'Revoir les trajets et les pauses quand il le faut',
  'Recevoir une alerte utile sur l’application ou WhatsApp',
  'Ouvrir facilement Trackeo sur téléphone, tablette ou ordinateur',
];

const operationalFeatures = [
  {
    slug: 'live',
    kicker: 'Suivi en direct',
    title: 'Voir la flotte telle qu\'elle roule vraiment',
    description:
      'Trackeo montre sur la carte la position, la vitesse, la batterie, le signal et le statut de chaque véhicule sans bruit visuel inutile.',
    bullets: [
      'Voir tous vos véhicules sur une seule carte',
      'Savoir s\'il roule, s\'il est arrêté ou s\'il ne répond plus',
      'Retrouver vite un véhicule par nom ou par plaque',
    ],
    stat: '10 s',
    note: 'mise à jour régulière pour garder le bon rythme',
    tone: 'mint',
  },
  {
    slug: 'history',
    kicker: 'Historique et rapports',
    title: 'Comprendre le trajet, pas seulement le point GPS',
    description:
      'L\'historique vous aide à revoir où le véhicule est passé, combien de temps il a roulé, quand il s\'est arrêté et quelle distance il a parcourue.',
    bullets: [
      'Revoir facilement les trajets de la journée',
      'Retrouver distance, durée et vitesse la plus élevée',
      'Comprendre les arrêts sans devoir tout reconstituer soi-même',
    ],
    stat: '30 jours',
    note: 'pour revoir les derniers déplacements plus sereinement',
    tone: 'amber',
  },
  {
    slug: 'alerts',
    kicker: 'Zones et alertes',
    title: 'Recevoir le bon signal avant l\'appel du chauffeur',
    description:
      'Vous choisissez une zone à surveiller et Trackeo vous prévient quand un véhicule entre, sort, roule trop vite ou commence à manquer de batterie.',
    bullets: [
      'Créer une zone de sécurité directement sur la carte',
      'Recevoir les messages sur l\'application ou WhatsApp',
      'Choisir simplement les alertes que vous voulez garder',
    ],
    stat: 'quelques secondes',
    note: 'pour réagir vite quand quelque chose change',
    tone: 'blue',
  },
  {
    slug: 'ops',
    kicker: 'Pour vous et votre équipe',
    title: 'Tout le monde garde les mêmes repères',
    description:
      'Quand plusieurs personnes suivent les mêmes véhicules, Trackeo garde les informations au même endroit pour éviter les appels inutiles et les oublis.',
    bullets: [
      'Le propriétaire voit ses véhicules en un coup d\'oeil',
      'La personne qui aide retrouve plus vite les bonnes infos',
      'Les véhicules, les alertes et l\'historique restent bien rangés',
    ],
    stat: '1 seul espace',
    note: 'pour parler de la même chose au bon moment',
    tone: 'ink',
  },
  {
    slug: 'reach',
    kicker: 'Accès facile',
    title: 'Ouvrir Trackeo sur l\'écran que vous avez déjà',
    description:
      'Trackeo est pensé pour être ouvert simplement sur téléphone, tablette ou ordinateur, sans vous compliquer la vie au moment de consulter vos véhicules.',
    bullets: [
      'Pratique sur téléphone quand vous êtes dehors',
      'Confortable sur ordinateur pour revoir l\'ensemble',
      'Toujours la même lecture simple d\'un écran à l\'autre',
    ],
    stat: '3 écrans',
    note: 'téléphone, tablette ou ordinateur',
    tone: 'paper',
  },
];

const roadmapPhases = [
  {
    label: 'En service',
    title: 'Le coeur du produit est déjà en ligne',
    copy:
      'Les bases utiles sont déjà là pour suivre un véhicule, revoir ses trajets et recevoir les alertes qui comptent.',
    items: [
      'Suivi en direct avec vitesse, batterie et état du véhicule',
      'Historique des trajets, des pauses et des dernières alertes',
      'Messages sur l\'application et sur WhatsApp',
      'Un espace de gestion pour garder les véhicules bien organisés',
    ],
    tone: 'mint',
  },
  {
    label: 'Prochaine vague',
    title: 'Rendre l\'activation et la réaction encore plus fluides',
    copy:
      'La suite vise surtout à rendre le démarrage plus simple et l\'accompagnement plus rassurant pour les premiers utilisateurs.',
    items: [
      'Ajouter un véhicule plus rapidement',
      'Partager plus facilement le suivi quand il le faut',
      'Mieux accompagner en cas d\'alerte ou de doute',
      'Guider pas à pas les premières mises en route',
    ],
    tone: 'blue',
  },
  {
    label: 'Extension',
    title: 'Passer de la flotte suivie à la flotte opérée',
    copy:
      'Plus tard, Trackeo pourra aller plus loin autour du véhicule sans perdre cette même logique simple et claire.',
    items: [
      'Plus de suivi autour des trajets et de l\'usage du véhicule',
      'Davantage d\'aide pour les familles et les petites flottes',
      'Des services pensés aussi pour les équipes qui grandissent',
      'Une ouverture plus large sur mobile et sur le terrain',
    ],
    tone: 'amber',
  },
];

const launchCards = [
  {
    name: 'Accès pilote',
    status: 'En petit groupe',
    detail: 'pour les premiers utilisateurs',
    description: 'Nous ouvrons Trackeo petit à petit pour bien accompagner les premiers utilisateurs.',
    features: [
      'Découvrir la carte en direct',
      'Recevoir les premières alertes utiles',
      'Revoir les trajets sans difficulté',
      'Prendre en main l\'application simplement',
    ],
    badge: 'Accès en préparation',
    note: 'Le produit s’ouvre d’abord à un petit nombre de véhicules pour garder un démarrage clair.',
    tone: 'paper',
  },
  {
    name: 'Liste d\'attente',
    status: 'Ouverture à venir',
    detail: 'nous prévenons avant l’ouverture',
    description: 'Une ouverture plus large arrive. Vous pourrez bientôt faire partie des prochains utilisateurs.',
    features: [
      'Un accès plus simple pour démarrer',
      'Une découverte guidée étape par étape',
      'Pensé pour particuliers et petites flottes',
      'Des nouvelles dès l\'ouverture plus large',
    ],
    badge: 'Vous serez prévenu',
    note: 'L’annonce de l’ouverture sera partagée dès que la prochaine vague sera prête.',
    tone: 'mint',
  },
  {
    name: 'Déploiement plus large',
    status: 'Ensuite',
    detail: 'quand le parcours sera bien calé',
    description: 'Trackeo est pensé pour s\'ouvrir ensuite à davantage de véhicules et à des usages plus larges.',
    features: [
      'Plus de véhicules à suivre',
      'Plus de partage quand c\'est utile',
      'Plus d\'aide pour les alertes importantes',
      'Toujours une interface claire à utiliser',
    ],
    badge: 'Progressif',
    note: 'Nous gardons la même simplicité quand le nombre de véhicules augmente.',
    tone: 'ink',
  },
];

const steps = [
  {
    number: '01',
    title: 'Brancher le boîtier dans le véhicule',
    text:
      'Une fois le boîtier en place, Trackeo peut commencer à recevoir les positions du véhicule.',
  },
  {
    number: '02',
    title: 'Ajouter le véhicule à votre espace',
    text:
      'Le véhicule apparaît dans votre espace pour que vous puissiez le retrouver facilement ensuite.',
  },
  {
    number: '03',
    title: 'Suivre, recevoir, réagir',
    text:
      'Vous voyez les trajets, vous recevez les alertes et vous gardez une lecture simple de la situation.',
  },
];
---

<Layout title="Trackeo | Tracking GPS clair, rapide et local pour les flottes">
  <header class="site-header">
    <div class="shell header-row">
      <a href="/" class="brand-lockup">
        <span class="brand-mark">
          <img src="/favicon.png" alt="Trackeo" width="22" height="22" />
        </span>
        <span class="brand-copy">
          <strong>Trackeo</strong>
          <span>application GPS pensée pour Madagascar</span>
        </span>
      </a>

      <nav class="site-nav" aria-label="Navigation principale">
        <a href="#plateforme">Plateforme</a>
        <a href="#mise-en-route">Démarrage</a>
        <a href="#roadmap">Cap produit</a>
        <a href="#coming-soon">Bientôt</a>
      </nav>

      <a href="https://trackeo.zenkai.mg" class="button button-dark">Découvrir Trackeo</a>
    </div>
  </header>

  <main id="content">
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy reveal">
          <p class="eyebrow">Pour garder un oeil sur vos véhicules sans passer la journée à appeler.</p>
          <h1>
            Quand vos véhicules sont dehors, vous gardez l&apos;esprit plus tranquille.
          </h1>
          <p class="hero-body">
            Trackeo vous montre où ils sont, où ils sont passés et vous prévient
            quand quelque chose mérite votre attention. Tout reste simple à lire,
            même depuis un téléphone.
          </p>

          <div class="hero-actions">
            <a href="https://trackeo.zenkai.mg" class="button button-brand">Découvrir l&apos;application</a>
            <a href="#coming-soon" class="button button-ghost">Voir l&apos;ouverture</a>
          </div>

          <ul class="hero-proof">
            {heroSignals.map((signal) => (
              <li>
                <span class="proof-dot" aria-hidden="true"></span>
                <span>{signal}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="hero-scene reveal reveal-delay-2">
          <div class="hero-slip hero-slip-top">
            <span class="slip-dot slip-dot-blue"></span>
            <span>Le véhicule vient d&apos;entrer dans la zone surveillée, message envoyé</span>
          </div>

          <div class="hero-board">
            <div class="hero-top-grid">
              <div class="map-sheet">
                <div class="map-meta">
                  <span class="mini-kicker">Suivi en direct</span>
                  <span class="mini-pill">Antananarivo centre</span>
                </div>

                <svg viewBox="0 0 640 360" class="route-scene" aria-hidden="true">
                  <defs>
                    <linearGradient id="mint-route" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="var(--brand-strong)" />
                      <stop offset="100%" stop-color="var(--blue)" />
                    </linearGradient>
                  </defs>

                  <g stroke="color-mix(in oklab, var(--ink) 10%, transparent)" stroke-width="1">
                    <line x1="0" y1="90" x2="640" y2="90" />
                    <line x1="0" y1="180" x2="640" y2="180" />
                    <line x1="0" y1="270" x2="640" y2="270" />
                    <line x1="106" y1="0" x2="106" y2="360" />
                    <line x1="228" y1="0" x2="228" y2="360" />
                    <line x1="365" y1="0" x2="365" y2="360" />
                    <line x1="520" y1="0" x2="520" y2="360" />
                  </g>

                  <circle cx="472" cy="110" r="72" fill="color-mix(in oklab, var(--blue) 12%, transparent)" />
                  <circle cx="472" cy="110" r="56" fill="none" stroke="color-mix(in oklab, var(--blue) 50%, white)" stroke-dasharray="5 8" stroke-width="3" />

                  <path
                    d="M 42 286 L 158 286 L 158 210 L 255 210 L 255 160 L 382 160 L 382 110 L 472 110"
                    fill="none"
                    stroke="url(#mint-route)"
                    stroke-width="10"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-dasharray="520"
                    stroke-dashoffset="520"
                    class="route-path"
                  />

                  <circle cx="472" cy="110" r="18" fill="var(--brand-strong)" />
                  <circle cx="472" cy="110" r="38" fill="color-mix(in oklab, var(--brand) 18%, transparent)" class="pulse-ring" />
                  <circle cx="255" cy="210" r="14" fill="var(--blue)" />
                  <circle cx="158" cy="286" r="12" fill="var(--amber)" />
                  <circle cx="42" cy="286" r="10" fill="var(--red)" />
                </svg>

                <div class="map-tag map-tag-main">
                  <strong>Camion-01</strong>
                  <span>72 km/h, batterie 84%</span>
                </div>
                <div class="map-tag map-tag-fence">
                  <strong>Zone surveillée</strong>
                  <span>Bureau, entrée confirmée</span>
                </div>
              </div>

              <div class="status-rail">
                <div class="status-sheet">
                  <span class="mini-kicker">Statuts</span>
                  <div class="status-line">
                    <span class="tone-dot tone-dot-mint"></span>
                    <div>
                      <strong>3 véhicules actifs</strong>
                      <span>camion, voiture, moto</span>
                    </div>
                  </div>
                  <div class="status-line">
                    <span class="tone-dot tone-dot-blue"></span>
                    <div>
                      <strong>2 en attente</strong>
                      <span>arrêtés mais connectés</span>
                    </div>
                  </div>
                  <div class="status-line">
                    <span class="tone-dot tone-dot-red"></span>
                    <div>
                      <strong>1 batterie faible</strong>
                      <span>message envoyé pour prévenir rapidement</span>
                    </div>
                  </div>
                </div>

                <div class="status-sheet status-sheet-contrast">
                  <span class="mini-kicker">Simple à ouvrir</span>
                  <p>
                    Consultez Trackeo facilement sur téléphone, tablette ou ordinateur,
                    selon l&apos;écran que vous avez sous la main.
                  </p>
                </div>
              </div>
            </div>

            <div class="hero-bottom-grid">
              <div class="feed-sheet">
                <div class="feed-head">
                  <div>
                    <span class="mini-kicker">Alertes et messages</span>
                    <h2>Être averti sans devoir surveiller tout le temps</h2>
                  </div>
                  <span class="mini-pill mini-pill-alert">Temps réel</span>
                </div>

                <ul class="feed-list">
                  <li>
                    <span class="feed-accent feed-accent-blue"></span>
                    <div>
                      <strong>Entrée dans une zone</strong>
                      <span>Camion-01, Bureau Central, il y a 12 s</span>
                    </div>
                  </li>
                  <li>
                    <span class="feed-accent feed-accent-red"></span>
                    <div>
                      <strong>Batterie faible</strong>
                      <span>Moto-04, 18%, notification envoyée</span>
                    </div>
                  </li>
                  <li>
                    <span class="feed-accent feed-accent-amber"></span>
                    <div>
                      <strong>Vitesse élevée</strong>
                      <span>Voiture-02, 124 km/h, message envoyé</span>
                    </div>
                  </li>
                </ul>

                <div class="feed-footer">
                  <div>
                    <span class="mini-kicker">Cette semaine</span>
                    <strong>1 234 km parcourus, trajets revus en un coup d&apos;oeil</strong>
                  </div>
                  <span class="mini-pill">Historique clair</span>
                </div>
              </div>

              <div class="phone-sheet">
                <div class="phone-frame">
                  <div class="phone-screen">
                    <div class="phone-head">
                      <div>
                        <span class="mini-kicker">Sur mobile</span>
                        <strong>Mes véhicules</strong>
                      </div>
                      <span class="phone-badge">3 actifs</span>
                    </div>

                    <div class="phone-card">
                      <div class="phone-row">
                        <div class="phone-icon phone-icon-green"></div>
                        <div>
                          <strong>Camion-01</strong>
                          <span>Analakely, en route</span>
                        </div>
                        <em>72 km/h</em>
                      </div>
                    </div>

                    <div class="phone-card phone-card-secondary">
                      <div class="phone-row">
                        <div class="phone-icon phone-icon-blue"></div>
                        <div>
                          <strong>Voiture-02</strong>
                          <span>Gare routière, arrêtée</span>
                        </div>
                        <em>il y a 2 min</em>
                      </div>
                    </div>

                    <div class="phone-settings">
                      <span class="mini-kicker">Mes alertes</span>
                      <div class="toggle-line">
                        <span>Messages</span>
                        <span class="toggle on"></span>
                      </div>
                      <div class="toggle-line">
                        <span>WhatsApp</span>
                        <span class="toggle on"></span>
                      </div>
                      <div class="toggle-line">
                        <span>Vitesse</span>
                        <span class="toggle off"></span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="hero-slip hero-slip-bottom">
            <span class="slip-dot slip-dot-mint"></span>
            <span>Vos véhicules, vos trajets et vos alertes restent au même endroit</span>
          </div>
        </div>
      </div>
    </section>

    <section class="shell signal-bar" aria-label="Résumé des fonctions Trackeo">
      <div class="signal-card">
        <p>Déjà en service</p>
        <div class="signal-list">
          <span>suivi en direct</span>
          <span>historique des trajets</span>
          <span>temps d&apos;arrêt</span>
          <span>vitesse élevée</span>
          <span>zones de sécurité</span>
          <span>alertes utiles</span>
          <span>WhatsApp</span>
          <span>application mobile</span>
          <span>liste de véhicules</span>
          <span>espace de gestion</span>
          <span>ouverture progressive</span>
        </div>
      </div>
    </section>

    <section class="section" id="plateforme">
      <div class="shell">
        <div class="section-head">
          <p class="eyebrow">La plateforme aujourd&apos;hui</p>
          <h2>Ce que vous voyez ici correspond à ce que Trackeo sait déjà faire.</h2>
          <p>
            Le but n&apos;est pas de montrer des mots compliqués, mais de faire comprendre
            rapidement ce que vous pourrez voir, recevoir et vérifier dans l&apos;application.
          </p>
        </div>

        <div class="story-stack">
          {operationalFeatures.map((feature, index) => (
            <article class={`story-card tone-${feature.tone} ${index % 2 === 1 ? 'story-reversed' : ''}`}>
              <div class="story-copy">
                <p class="story-kicker">{feature.kicker}</p>
                <h3>{feature.title}</h3>
                <p class="story-description">{feature.description}</p>

                <ul class="story-points">
                  {feature.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>

                <div class="story-meta">
                  <strong>{feature.stat}</strong>
                  <span>{feature.note}</span>
                </div>
              </div>

              <div class={`story-visual visual-${feature.slug}`}>
                {feature.slug === 'live' && (
                  <>
                    <div class="visual-raster">
                      <div class="visual-map-grid"></div>
                      <div class="visual-route visual-route-a"></div>
                      <div class="visual-route visual-route-b"></div>
                      <div class="visual-dot visual-dot-main"></div>
                      <div class="visual-dot visual-dot-blue"></div>
                      <div class="visual-dot visual-dot-amber"></div>
                    </div>
                    <div class="visual-sheet">
                      <div class="sheet-line">
                        <span class="tone-dot tone-dot-mint"></span>
                        <span>Camion-01 en route, 72 km/h</span>
                      </div>
                      <div class="sheet-line">
                        <span class="tone-dot tone-dot-blue"></span>
                        <span>Voiture-02 arrêtée, toujours visible</span>
                      </div>
                      <div class="sheet-line">
                        <span class="tone-dot tone-dot-red"></span>
                        <span>Bus-03 ne répond plus, dernière position gardée</span>
                      </div>
                    </div>
                  </>
                )}

                {feature.slug === 'history' && (
                  <>
                    <div class="history-line">
                      <span></span>
                      <span></span>
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>
                    <div class="history-graph">
                      <div class="history-bar" style="--h: 42%"></div>
                      <div class="history-bar" style="--h: 68%"></div>
                      <div class="history-bar" style="--h: 53%"></div>
                      <div class="history-bar" style="--h: 84%"></div>
                      <div class="history-bar" style="--h: 73%"></div>
                      <div class="history-bar" style="--h: 96%"></div>
                    </div>
                    <div class="history-caption">
                      <strong>Distance, pauses et trajets</strong>
                      <span>Pour revoir la journée sans se perdre dans les détails</span>
                    </div>
                  </>
                )}

                {feature.slug === 'alerts' && (
                  <>
                    <div class="bubble bubble-blue">
                      <strong>Entrée dans une zone</strong>
                      <span>Camion-01, Bureau Central</span>
                    </div>
                    <div class="bubble bubble-red">
                      <strong>Batterie faible</strong>
                      <span>Moto-04, 18%, message envoyé</span>
                    </div>
                    <div class="bubble bubble-amber">
                      <strong>Vitesse élevée</strong>
                      <span>Voiture-02, vitesse au-dessus du niveau attendu</span>
                    </div>
                    <div class="settings-grid">
                      <span class="mini-pill">messages</span>
                      <span class="mini-pill">WhatsApp</span>
                      <span class="mini-pill">batterie</span>
                      <span class="mini-pill">vitesse</span>
                    </div>
                  </>
                )}

                {feature.slug === 'ops' && (
                  <>
                    <div class="admin-board">
                      <div>
                        <span>Véhicules</span>
                        <strong>tout retrouver en un seul endroit</strong>
                      </div>
                      <div>
                        <span>Personnes</span>
                        <strong>partager plus facilement les mêmes infos</strong>
                      </div>
                      <div>
                        <span>Alertes</span>
                        <strong>voir vite ce qui demande votre attention</strong>
                      </div>
                      <div>
                        <span>Aide</span>
                        <strong>garder un suivi plus simple au quotidien</strong>
                      </div>
                    </div>
                    <div class="ops-footer">
                      <span>Historique</span>
                      <span>Zones</span>
                      <span>Réglages</span>
                    </div>
                  </>
                )}

                {feature.slug === 'reach' && (
                  <>
                    <div class="reach-cloud">
                      <span>Téléphone</span>
                      <span>Tablette</span>
                      <span>Ordinateur</span>
                      <span>Camion</span>
                      <span>Voiture</span>
                      <span>Moto</span>
                      <span>Bus</span>
                      <span>Suivi partagé</span>
                    </div>
                    <div class="reach-devices">
                      <div class="device desktop"></div>
                      <div class="device phone"></div>
                    </div>
                  </>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-steps" id="mise-en-route">
      <div class="shell">
        <div class="section-head section-head-narrow">
          <p class="eyebrow">Mise en route</p>
          <h2>Le démarrage doit rester simple, même si vous suivez plusieurs véhicules.</h2>
        </div>

        <div class="steps-grid">
          {steps.map((step) => (
            <article class="step-panel">
              <span class="step-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="roadmap">
      <div class="shell">
        <div class="section-head">
          <p class="eyebrow">Cap produit</p>
          <h2>Ce qui est déjà là, ce qui arrive bientôt, ce qui viendra plus tard.</h2>
          <p>
            Nous préférons montrer clairement ce qui existe déjà et ce qui arrive ensuite,
            pour garder une promesse simple et crédible.
          </p>
        </div>

        <div class="roadmap-grid">
