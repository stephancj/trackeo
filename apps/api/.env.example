NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=trackeo
DB_PASS=Password_1234
DB_NAME=traccar_db

# API Traccar — nécessaire pour activer un nouveau traceur depuis l'app
TRACCAR_API_URL=http://localhost:8082
TRACCAR_API_EMAIL=your-traccar-admin@example.com
TRACCAR_API_PASSWORD=change_this_password

# JWT — CHANGER EN PRODUCTION (openssl rand -hex 64)
JWT_SECRET=trackeo_dev_secret_change_in_prod

# OneSignal Push Notifications (dashboard.onesignal.com)
ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ONESIGNAL_API_KEY=os_v2_app_xxxxxxxxxxxxxxxx

# WhatsApp Business API (developers.facebook.com)
WHATSAPP_API_TOKEN=xxxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=xxxxxxxxxxxxxxxx

# URLs publiques utilisées par PAPI et les liens de partage
PUBLIC_APP_URL=https://app.iooeh.com
PUBLIC_API_URL=https://api.iooeh.com

# Paiement PAPI.mg — clé obtenue dans Boutiques > Développeur
PAPI_API_KEY=
PAPI_TEST_MODE=true

# Incidents (webhook partenaire optionnel, signé HMAC-SHA256)
INCIDENT_ESCALATION_MINUTES=10
SECURITY_PARTNER_WEBHOOK_URL=
SECURITY_PARTNER_WEBHOOK_SECRET=

# Cloudflare Turnstile — protection du formulaire public de waitlist
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=iooeh.com,www.iooeh.com

# Brevo — emails transactionnels et vérification de la waitlist
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notifications@iooeh.com
BREVO_SENDER_NAME=iooeh
BREVO_REPLY_TO_EMAIL=contact@iooeh.com
PUBLIC_LANDING_URL=https://iooeh.com
